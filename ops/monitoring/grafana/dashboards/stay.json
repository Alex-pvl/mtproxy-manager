      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(stay_http_requests_total{code=~\"5..\"}[5m]))",
          "legendFormat": "5xx rps"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(stay_http_request_duration_seconds_bucket{route=~\"/api/.*\"}[5m])))",
          "legendFormat": "p95, s"
