+/** Amount next to stars/months control: RUB for SBP/CryptoBot, TON for wallet. */
+function quoteSideLabel(quote: ProductQuote, method: PayMethod): string {
+  if (method === 'ton') {
+    const nano = Number(quote.ton_amount);
+    if (!Number.isFinite(nano) || nano <= 0) return '';
+    const ton = nano / 1e9;
+    const s = ton >= 1 ? ton.toFixed(3) : ton.toFixed(4);
+    return `≈${s} TON`;
+  }
+  return quote.price_rub;
+}
+
+function quoteTotalPrimary(quote: ProductQuote, method: PayMethod): string {
+  return method === 'ton' ? quoteSideLabel(quote, 'ton') : quote.price_rub;
+}
