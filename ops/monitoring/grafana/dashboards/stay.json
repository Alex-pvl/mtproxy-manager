    {
      "type": "timeseries",
      "title": "Оплаты по провайдерам (за час)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "id": 6,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider) (increase(stay_payments_fulfilled_total[1h]))",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 15
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Созданные vs оплаченные (за час)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(stay_payments_created_total[1h]))",
          "legendFormat": "создано"
        },
        {
          "refId": "B",
          "expr": "sum(increase(stay_payments_fulfilled_total[1h]))",
          "legendFormat": "оплачено"
        },
        {
          "refId": "C",
          "expr": "sum(increase(stay_payment_fulfill_errors_total[1h]))",
          "legendFormat": "ошибка активации"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 5
