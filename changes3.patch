+def _is_already_premium_fragment_msg(text: str) -> bool:
+    """True if Fragment / SDK says the user already has Premium (localized strings)."""
+    if not text:
+        return False
+    t = text.lower()
+    if "premium" not in t:
+        return False
+    return (
+        "already subscribed" in t
+        or "already has" in t
+        or "уже подписан" in t
+        or "уже есть" in t
+    )
+
+
+def _api_result_error(result) -> str:
+    if result is None:
+        return "recipient not found"
+    err = getattr(result, "error", None)
+    return str(err) if err else "recipient not found"
+
