JWT_SECRET=

CRYPTOBOT_TOKEN=

# DigitalPay (SBP/NSPK) integration
DIGITALPAY_API_KEY=
DIGITALPAY_BASE_URL=https://digitalpay.cc
# Optional return URL after SBP payment completion (e.g. https://t.me/your_bot?start=paid)
DIGITALPAY_SBP_BACK_URL=

# TON payments: your TON wallet address for receiving direct TON transfers
TON_WALLET_ADDRESS=UQDQbRJs32yYxOy-ZscoZ9Tlj_pH6D0jeS7a8U5oSkzkicwR

# Telegram Login (get from @BotFather → Bot Settings → Web Login)
TG_BOT_TOKEN=
# Telegram bot username without @ (used for Mini App referral startapp links)
TG_BOT_USERNAME=
# Ссылка на Mini App «оплата» (ответ на /start в боте)
TG_PAY_URL=https://t.me/staytg_bot/pay
# OIDC: Client ID and Secret from BotFather (Bot Settings → Web Login)
TG_CLIENT_ID=
TG_CLIENT_SECRET=
# Frontend: Telegram Bot Client ID (numeric Bot ID, same as TG_CLIENT_ID)
VITE_TG_CLIENT_ID=

# Admin: Telegram user ID that will be auto-promoted to admin
ADMIN_TELEGRAM_ID=
ADMIN_USERNAME=admin
# Optional: set to enable admin login via username/password
ADMIN_PASSWORD=

SERVER_IP=
SERVER_PORT=3000
BASE_URL=https://staytg.org

# PostgreSQL DSN
DATABASE_URL=postgres://mtproxy:yourpassword@localhost:5432/mtproxy?sslmode=disable

PORT_MIN=8000
PORT_MAX=9999
SOCKS5_PORT_MIN=10000
SOCKS5_PORT_MAX=10999
DEFAULT_MAX_PROXIES=5

MTG_IMAGE=nineseconds/mtg:2
GOST_IMAGE=ginuerzh/gost:2.12

# x-ui / 3x-ui panel integration for VLESS VPN links (optional)
# Leave XUI_URL empty to disable VLESS support
XUI_URL=https://muftifan.ru
XUI_PATH_PREFIX=vwtLfHqxkCntctQ   # custom panel base path (Security → Panel Settings → Panel Base Path)
XUI_USERNAME=admin
XUI_PASSWORD=your-xui-password
XUI_INBOUND_ID=1
# 3x-ui v3+: Settings → Security → API Token (then USERNAME/PASSWORD are unused)
XUI_API_TOKEN=

# ─── Fragment worker (Telegram Stars / Premium via Fragment) ──────────────────
# URL of the Python sidecar (see fragment-worker/). Inside docker-compose this is
# the service name. Set empty to disable Stars/Premium products entirely.
FRAGMENT_WORKER_URL=http://fragment-worker:8080
# Bearer token shared between backend and worker. Generate any random string.
FRAGMENT_WORKER_TOKEN=
# Markup % applied on top of Fragment cost when pricing for the user (15 = +15%).
STARS_MARKUP_PCT=15
PREMIUM_MARKUP_PCT=15
# Block new orders if wallet balance would drop below this (in nanoTON, default 0.5 TON).
MIN_TON_BALANCE_NANO=500000000

# Worker-only secrets (NEVER expose to backend or frontend):
# 24-word TON wallet seed of the verified Fragment account, space-separated.
WALLET_MNEMONIC=
# Wallet contract version: v5r1 (default) or v4r2.
FRAGMENT_WALLET_VERSION=v5r1
# Cookies header value for fragment.com (export from a logged-in session — see worker README).
FRAGMENT_COOKIES=
# TonAPI key (https://tonapi.io — register, free tier is fine for low volume).
TONAPI_KEY=
